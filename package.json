{
  "name": "hypertroph-plus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "hypertroph+ — offline-first nutrition & hypertrophy training tracker (base model)",
  "author": "sensei628",
  "repository": {
    "type": "git",
    "url": "https://github.com/sensei628/Hypertroph-plus.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node tools/compliance/check-compliance.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:compliance": "node tools/compliance/check-compliance.mjs",
    "data:download:usda": "powershell -ExecutionPolicy Bypass -File tools/import/download-usda.ps1",
    "data:build:usda": "node tools/import/build-usda.mjs",
    "data:download:exercises": "powershell -ExecutionPolicy Bypass -File tools/import/download-exercises.ps1",
    "data:build:exercises": "node tools/import/import-exercises.mjs",
    "data:verify": "node tools/import/verify-ref.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "mobile:android": "npm run build && cap sync android && cap open android",
    "mobile:ios": "npm run build && cap sync ios && cap open ios",
    "desktop:start": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win --publish never",
    "desktop:release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
