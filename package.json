{
  "name": "hypertroph-plus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "hypertroph+ \u2014 offline-first nutrition & hypertrophy training tracker (base model)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node tools/compliance/check-compliance.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:compliance": "node tools/compliance/check-compliance.mjs",
    "data:download:usda": "powershell -ExecutionPolicy Bypass -File tools/import/download-usda.ps1",
    "data:build:usda": "node tools/import/build-usda.mjs",
    "data:verify": "node tools/import/verify-ref.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
